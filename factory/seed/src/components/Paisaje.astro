---
// The picture field of the home hero: the cut lemon as a disc and the Vega del Segura as a small framed photograph. Purely visual.
---
<div class="hero__campo">
  <div class="hero__disco">
    <img src="/fotos/limon-cortado.webp" width="800" height="800" alt="Un limón cortado por la mitad, con sus gajos" />
  </div>
  <figure class="fig hero__vega">
    <img src="/fotos/vega-del-segura.webp" width="1600" height="790" alt="Campos de regadío de la Vega del Segura vistos desde la sierra" />
    <figcaption>La Vega del Segura</figcaption>
  </figure>
</div>
