---
import Base from '../layouts/Base.astro'
import { CELDAS } from '../lib/tablero.js'

const totales = [
  ['peticiones', 'Peticiones', ''],
  ['desplegadas', 'En producción', 't-ok'],
  ['esperando', 'Esperando', 't-esp'],
  ['rechazadas', 'Rechazadas', 't-no'],
]
const leyenda = [
  ['ok', '✓', 'Ok'],
  ['en_curso', '●', 'En curso'],
  ['rechazada', '!', 'Rechazada'],
  ['pendiente', '–', 'Pendiente'],
]
---
<Base title="Factory" description="La factory de LIMONIA en directo: cada petición, estación a estación.">
  <div class="sala">
    <div class="tt">
      <p class="sobretitulo">Factory</p>
      <h1>La factory en directo</h1>
      <p id="tablero-estado" class="modo" role="status" aria-live="polite"></p>
    </div>

    <section class="sig" aria-label="Sigue tu petición">
      <form id="sigue" autocomplete="off">
        <label for="sigue-n">Sigue tu petición #</label>
        <div class="fl">
          <input id="sigue-n" name="n" type="text" inputmode="numeric" pattern="[0-9]{1,9}" maxlength="9" />
          <button class="boton" type="submit">Seguir</button>
        </div>
      </form>
      <p class="sg" id="siguiendo" role="status" aria-live="polite"></p>
    </section>

    <dl class="totales" aria-label="Contadores">
      {totales.map(([id, label, clase]) => (
        <div class={`total ${clase}`.trim()}><dd data-total={id}>0</dd><dt>{label}</dt></div>
      ))}
    </dl>

    <section class="fila-lista" aria-labelledby="h-pet">
      <h2 id="h-pet" class="sr-only">Peticiones</h2>
      <div class="cab-t" aria-hidden="true">
        <div></div><div></div>
        <div class="gr" style="grid-column:3/6">Preparación</div>
        <div class="gr rv" style="grid-column:6/10">Revisión en paralelo</div>
        <div class="gr" style="grid-column:10/11">&nbsp;</div>
        <div class="gr rg" style="grid-column:11/13">Puerta de riesgo</div>
        <div class="gr" style="grid-column:13/14">&nbsp;</div>
        <div class="nn2">N.º</div><div class="peti">Petición</div>
        {CELDAS.map(({ etiqueta }) => <div class="h">{etiqueta}</div>)}
      </div>
      <ol class="filas" id="filas"></ol>
      <p class="vacio" id="filas-vacio">No hay peticiones en la factory ahora mismo.</p>
    </section>

    <section class="puerta" aria-labelledby="h-pu">
      <h2 id="h-pu">¿Humano?</h2>
      <p>Lo decide el diff, no quien lo pide.</p>
      <div class="ramas">
        <div class="rama a"><span class="k2" data-puerta="auto">0</span><span>Automático<span class="dest"> → Main</span><small>sin esperar</small></span></div>
        <div class="rama p"><span class="k2" data-puerta="persona">0</span><span>Una persona<span class="dest"> → PR</span><small>espera su aprobación</small></span></div>
      </div>
    </section>

    <section class="cola" aria-labelledby="h-co">
      <h2 id="h-co">Esperando a una persona</h2>
      <ol id="cola"></ol>
      <p class="vacio" id="cola-vacia">Nadie espera ahora mismo.</p>
    </section>

    <div class="ley" aria-label="Leyenda de estados">
      {leyenda.map(([estado, simbolo, texto]) => <span><b class={`mark s-${estado}`}>{simbolo}</b>{texto}</span>)}
    </div>
  </div>
<script>
  import { CELDAS, ahora, celdas, puertas, rechazo, retencion, siguiendo } from '../lib/tablero.js'
  import { esDemo, sondearDemo } from '../components/demo-datos.js'
  import { sondear } from '../lib/sondeo.js'

  const lista = document.getElementById('filas')
  const sinFilas = document.getElementById('filas-vacio')
  const estado = document.getElementById('tablero-estado')
  const linea = document.getElementById('siguiendo')
  const cola = document.getElementById('cola')
  const colaVacia = document.getElementById('cola-vacia')
  const formulario = document.getElementById('sigue')
  const entrada = document.getElementById('sigue-n')
  const estrecha = matchMedia('(max-width: 1199.98px)')
  const demo = esDemo()

  const nodo = (etiqueta, clase, texto) => {
    const el = document.createElement(etiqueta)
    if (clase) el.className = clase
    if (texto !== undefined) el.textContent = texto
    return el
  }
  const numeroValido = (valor) => (/^\d{1,9}$/.test(valor ?? '') ? Number(valor) : null)

  let ultimo = null
  let primera = true
  let seguida = numeroValido(new URLSearchParams(location.search).get('n'))
  if (seguida) entrada.value = String(seguida)
  const vistas = new Map() // number → { desde: first time seen in a final state, retirada }
  const filas = new Map() // number → the row's elements

  // One row: the title, 11 cells in the order of the stations, "ahora en" (phones) and the motivo of a rejection.
  function crearFila() {
    const li = nodo('li', 'fila')
    const nn = nodo('span', 'nn')
    nn.append(nodo('span', 'sr-only', 'Petición '), document.createTextNode(''))
    const titulo = nodo('span', 'pt', '')
    const tu = nodo('span', 'tu')
    tu.append(nodo('span', 'sr-only', 'Tu petición'), nodo('span', 'lg', 'Tu petición'), nodo('span', 'sh', 'Tú'))
    tu.lastChild.setAttribute('aria-hidden', 'true')
    tu.children[1].setAttribute('aria-hidden', 'true')
    const cl = nodo('div', 'cl')
    cl.append(nn, titulo)
    li.append(cl)
    const casillas = CELDAS.map((_, i) => {
      if (i === 3 || i === 7) {
        const sp = nodo('span', 'sp')
        sp.setAttribute('aria-hidden', 'true')
        li.append(sp)
      }
      const k = nodo('span', `k${i >= 3 && i <= 6 ? ' rv' : ''}${i === 3 ? ' i' : ''}`)
      const c = nodo('span', 'c')
      const g = nodo('span', 'g', '')
      const d = nodo('span', 'd', '')
      const lectura = nodo('span', 'sr-only', '')
      g.setAttribute('aria-hidden', 'true')
      d.setAttribute('aria-hidden', 'true')
      c.append(g, d, lectura)
      k.append(c)
      li.append(k)
      return { c, g, d, lectura }
    })
    const est = nodo('span', 'est')
    const marca = nodo('span', 'mark', '')
    marca.setAttribute('aria-hidden', 'true')
    const nombre = document.createTextNode('')
    est.append(marca, nombre)
    const palabra = nodo('span', '', '')
    const ahoraEn = nodo('p', 'ahora')
    ahoraEn.append(est, palabra)
    const motivo = nodo('p', 'mo')
    const motivoTitulo = nodo('b', '', '')
    const motivoTexto = nodo('span', '', '')
    motivo.append(motivoTitulo, motivoTexto)
    li.append(ahoraEn, motivo)
    return { li, nn, titulo, tu, casillas, est, marca, nombre, palabra, motivo, motivoTitulo, motivoTexto }
  }

  // Everything written goes through textContent: titles and motivos come from the audience.
  function pintarFila(fila, t) {
    const suya = t.numero === seguida
    const rec = rechazo(t)
    fila.li.className = `fila${suya ? ' seg' : ''}${rec ? ' rec' : ''}`
    fila.nn.lastChild.textContent = `#${t.numero}`
    fila.titulo.textContent = t.titulo ?? ''
    fila.titulo.append(fila.tu)
    fila.tu.hidden = !suya
    celdas(t).forEach((celda, i) => {
      const { c, g, d, lectura } = fila.casillas[i]
      const ruta = t.ruta === 'human' ? ' pers' : ' auto'
      c.className = `c s-${celda.estado}${celda.texto ? ` tx${ruta}` : ''}`
      g.textContent = celda.glifo
      d.textContent = celda.texto ?? ''
      lectura.textContent = celda.lectura
    })
    const donde = ahora(t)
    fila.est.className = `est s-${donde.estado}`
    fila.marca.textContent = donde.glifo
    fila.nombre.textContent = donde.etiqueta
    fila.palabra.textContent = donde.palabra
    fila.motivo.hidden = !rec
    fila.motivoTitulo.textContent = rec?.titulo ?? ''
    fila.motivoTexto.textContent = rec?.motivo ?? ''
  }

  // A finished task stays in the table for a while (30 s a rejection, 4 s a deployment) and then leaves for its counter.
  // One already finished when the page opened goes straight to the counters, except in the demo, which must show them.
  // The request being followed never leaves.
  function visibles(tareas) {
    const ahoraMs = Date.now()
    return tareas.filter((t) => {
      const espera = retencion(t.resultadoFinal)
      if (!espera || t.numero === seguida) return true
      const vista = vistas.get(t.numero)
      if (!vista || vista.retirada) return false
      if (ahoraMs - vista.desde >= espera) vista.retirada = true
      return !vista.retirada
    })
  }

  function pintar(datos) {
    ultimo = datos
    const tareas = datos.tareas ?? []
    const vivas = new Set(tareas.map((t) => t.numero))
    for (const n of [...vistas.keys()]) if (!vivas.has(n)) vistas.delete(n)
    for (const t of tareas) {
      if (retencion(t.resultadoFinal) && !vistas.has(t.numero)) vistas.set(t.numero, { desde: Date.now(), retirada: primera && !demo })
    }
    primera = false
    for (const [n, fila] of filas) if (!vivas.has(n)) filas.delete(n)

    const c = datos.contadores ?? {}
    for (const total of document.querySelectorAll('[data-total]')) {
      const id = total.dataset.total
      total.textContent = String(id === 'rechazadas' ? (c.rechazadas ?? 0) + (c.fallidas ?? 0) + (c.cerradas ?? 0) + (c.bloqueadas_tests ?? 0) : (c[id] ?? 0))
    }
    const rutas = puertas(tareas)
    for (const k of document.querySelectorAll('[data-puerta]')) k.textContent = String(rutas[k.dataset.puerta])
    cola.replaceChildren(...(datos.cola ?? []).map((q) => {
      const item = nodo('li')
      const pr = nodo('div', 'pr')
      const link = nodo('a', '', `PR #${q.pr}`)
      link.href = q.url
      pr.append(link, nodo('span', '', `petición #${q.tarea ?? '?'}`))
      item.append(pr, nodo('p', '', q.titulo ?? ''))
      return item
    }))
    colaVacia.hidden = (datos.cola ?? []).length > 0
    estado.textContent = demo ? 'MODO DEMO · datos de ejemplo' : ''
    linea.textContent = siguiendo(seguida, tareas.find((t) => t.numero === seguida))
    dibujar()
    return false
  }

  // Newest first; on a phone or tablet the followed request goes first in the DOM too (screen readers read it first).
  function dibujar() {
    if (!ultimo) return
    const tareas = visibles([...(ultimo.tareas ?? [])].sort((a, b) => b.numero - a.numero))
    if (estrecha.matches) tareas.sort((a, b) => Number(b.numero === seguida) - Number(a.numero === seguida))
    const elementos = tareas.map((t) => {
      const fila = filas.get(t.numero) ?? crearFila()
      filas.set(t.numero, fila)
      pintarFila(fila, t)
      return fila.li
    })
    lista.replaceChildren(...elementos)
    sinFilas.hidden = elementos.length > 0
  }
  setInterval(dibujar, 500)
  estrecha.addEventListener('change', dibujar)

  formulario.addEventListener('submit', (event) => {
    event.preventDefault()
    seguida = numeroValido(entrada.value.trim().replace(/^#/, ''))
    const url = new URL(location.href)
    if (seguida) url.searchParams.set('n', String(seguida))
    else url.searchParams.delete('n')
    history.replaceState(null, '', url)
    if (ultimo) pintar(ultimo)
  })

  if (demo) {
    sondearDemo(pintar)
  } else {
    sondear('/api/estado', pintar, () => {
      estado.textContent = 'Sin conexión con la factory. Reintentando…'
    })
  }
</script>
</Base>
