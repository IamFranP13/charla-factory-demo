---
import '../styles/fuentes.css'
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

const { title, description = 'LIMONIA exporta fruta y hortalizas de Murcia a toda Europa.' } = Astro.props
const pagina = title === 'LIMONIA' ? title : `${title} · LIMONIA`
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#5b6b2e" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pagina}</title>
    <script is:inline>document.documentElement.classList.add('js')</script>
    <slot name="head" />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Header actual={Astro.url.pathname} />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <script>
      // Entrances: each [data-sube] rises once when it comes into view (the failsafe shows everything after 3 s).
      const elementos = [...document.querySelectorAll('[data-sube]')]
      const mostrar = (e) => e.classList.add('dentro')
      if (!('IntersectionObserver' in window)) elementos.forEach(mostrar)
      else {
        const io = new IntersectionObserver((entradas) => {
          for (const x of entradas) if (x.isIntersecting) { mostrar(x.target); io.unobserve(x.target) }
        }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' })
        requestAnimationFrame(() => elementos.forEach((e) => (e.getBoundingClientRect().top < innerHeight ? mostrar(e) : io.observe(e))))
        setTimeout(() => elementos.forEach(mostrar), 3000)
      }
    </script>
  </body>
</html>
