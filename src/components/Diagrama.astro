---
import { PASOS } from '../lib/diagrama.js'

// The factory scheme as a stepper of cards, drawn at build time from the steps in src/lib/diagrama.js. Cards start
// neutral; diagrama-cliente.js paints a task on them.
---
<ol class="ruta" data-diagrama aria-label="Recorrido de una petición por la factory">
  {PASOS.map((paso) => (
    <li class="paso" data-paso={paso.id} data-estado="neutro">
      <span class="paso__marca" aria-hidden="true"></span>
      <h3 class="paso__nombre" data-nombre>{paso.label}</h3>
      {paso.nota && <p class="paso__nota">{paso.nota}</p>}
      {paso.subpasos && (
        <ul class="revisores" aria-label="Revisores en paralelo">
          {paso.subpasos.map((sub) => <li class="revisor" data-revisor={sub.id} data-estado="neutro">{sub.label}</li>)}
        </ul>
      )}
      <p class="paso__etiqueta" data-etiqueta hidden></p>
    </li>
  ))}
</ol>
