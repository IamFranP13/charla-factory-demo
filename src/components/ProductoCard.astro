---
import { eur } from '../lib/formato.js'

const { producto } = Astro.props
---
<li class="producto" id={`producto-${producto.id}`} data-sube>
  <span class:list={['bola', producto.categoria === 'fruta' ? '' : 'bola--verde']} aria-hidden="true"></span>
  <div>
    <div class="carta__nombre">
      <h3>{producto.nombre}</h3>
      {producto.precioKg === null ? <p class="carta__precio carta__consultar">Precio a consultar</p> : <p class="carta__precio">{eur(producto.precioKg)} <small>/ kg</small></p>}
    </div>
    <p class="d">{producto.descripcion}</p>
    <p class="meta"><span class:list={['ins', producto.disponible ? 'ins--ok' : 'ins--no']}>{producto.disponible ? 'Disponible' : 'No disponible'}</span> {producto.origen}</p>
  </div>
</li>
