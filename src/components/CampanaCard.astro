---
const { campana } = Astro.props
---
<li class={`campana campana--${campana.color}`} id={`campana-${campana.id}`} data-sube>
  <div class="campana__texto">
    <h3>{campana.titulo}</h3>
  </div>
  <p>{campana.texto}</p>
  {campana.cta && <a class="btn" href="/presupuesto/">{campana.cta}</a>}
</li>
