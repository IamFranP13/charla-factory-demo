---
import { MAX_LENGTH } from '../../lib/intake.js'

const siteKey = process.env.TURNSTILE_SITE_KEY ?? ''
---
<form id="peticion" class="formulario" novalidate>
  <label for="texto">¿Qué quieres cambiar en LIMONIA?</label>
  <textarea id="texto" name="peticion" maxlength={MAX_LENGTH} rows="3" required placeholder="Ej.: una campaña verde sobre el limón de temporada"></textarea>
  <p class="formulario__contador" aria-hidden="true"><span id="contador">0</span> / {MAX_LENGTH}</p>
  <div class="cf-turnstile" data-sitekey={siteKey}></div>
  <button class="boton" type="submit">Enviar a la factory</button>
  <p id="estado" role="status" aria-live="polite"></p>
</form>

<script>
  import { guardar } from '../lib/tareas-guardadas.js'

  const PERFILES = { marketing: 'Marketing', producto: 'Producto', negocio: 'Negocio' }
  const form = document.getElementById('peticion')
  const estado = document.getElementById('estado')
  const texto = document.getElementById('texto')
  const contador = document.getElementById('contador')

  texto.addEventListener('input', () => {
    contador.textContent = String([...texto.value].length)
  })

  form.addEventListener('submit', async (event) => {
    event.preventDefault()
    const button = form.querySelector('button')
    const data = new FormData(form)
    button.disabled = true
    estado.replaceChildren('Enviando…')
    try {
      const response = await fetch('/api/peticion', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ peticion: data.get('peticion'), turnstile: data.get('cf-turnstile-response') ?? '' }),
      })
      const body = await response.json().catch(() => ({}))
      if (response.ok) {
        const link = document.createElement('a')
        link.href = `/tarea/?n=${encodeURIComponent(body.tarea)}`
        link.textContent = 'Sigue tu petición'
        estado.replaceChildren(`Recibida: tarea #${body.tarea}. Te ha tocado pedirlo como ${PERFILES[body.perfil] ?? body.perfil}. `, link)
        guardar(body.tarea)
        window.dispatchEvent(new Event('limonia:tareas'))
        form.reset()
        contador.textContent = '0'
      } else {
        estado.replaceChildren(body.error ?? 'No se ha podido enviar.')
      }
    } catch {
      estado.replaceChildren('No se ha podido enviar. ¿Hay conexión?')
    } finally {
      button.disabled = false
      window.turnstile?.reset()
    }
  })
</script>
