---
import { MAX_LENGTH } from '../../lib/intake.js'

const siteKey = process.env.TURNSTILE_SITE_KEY ?? ''
---
<form id="peticion" class="pide__form" novalidate data-sube>
  <h2 id="pide-titulo">Pide un cambio</h2>
  <p>Tu petición entra en una pequeña fábrica de agentes de IA. El perfil con el que la pides (Marketing, Producto o Negocio) se sortea al azar, así que no puedes elegirlo.</p>
  <div class="campo">
    <label for="texto">¿Qué quieres cambiar en LIMONIA?</label>
    <textarea id="texto" name="peticion" maxlength={MAX_LENGTH} rows="3" required placeholder="Ej.: una campaña verde sobre el limón de temporada" aria-describedby="contador-texto"></textarea>
    <p class="contador" id="contador-texto" aria-hidden="true"><span>Máximo {MAX_LENGTH} caracteres</span><span><strong id="contador">0</strong> / {MAX_LENGTH}</span></p>
  </div>
  <div class="cf-turnstile" data-sitekey={siteKey}></div>
  <button class="btn" type="submit">Enviar a la factory</button>
  <p class="pide__estado" id="estado" role="status" aria-live="polite"></p>
</form>

<script>
  import { guardar } from '../lib/tareas-guardadas.js'

  const PERFILES = { marketing: 'Marketing', producto: 'Producto', negocio: 'Negocio' }
  const form = document.getElementById('peticion')
  const estado = document.getElementById('estado')
  const texto = document.getElementById('texto')
  const contador = document.getElementById('contador')

  texto.addEventListener('input', () => {
    const letras = [...texto.value].length
    contador.textContent = String(letras)
    contador.parentElement.parentElement.classList.toggle('contador--lleno', letras >= texto.maxLength)
  })

  form.addEventListener('submit', async (event) => {
    event.preventDefault()
    const button = form.querySelector('button')
    const data = new FormData(form)
    button.disabled = true
    estado.replaceChildren('Enviando…')
    try {
      const response = await fetch('/api/peticion', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ peticion: data.get('peticion'), turnstile: data.get('cf-turnstile-response') ?? '' }),
      })
      const body = await response.json().catch(() => ({}))
      if (response.ok) {
        const link = document.createElement('a')
        link.href = `/tarea/?n=${encodeURIComponent(body.tarea)}`
        link.textContent = 'Sigue tu petición'
        estado.replaceChildren(`Recibida: tarea #${body.tarea}. Te ha tocado pedirlo como ${PERFILES[body.perfil] ?? body.perfil}. `, link)
        guardar(body.tarea)
        window.dispatchEvent(new Event('limonia:tareas'))
        form.reset()
        contador.textContent = '0'
      } else {
        estado.replaceChildren(body.error ?? 'No se ha podido enviar.')
      }
    } catch {
      estado.replaceChildren('No se ha podido enviar. ¿Hay conexión?')
    } finally {
      button.disabled = false
      window.turnstile?.reset()
    }
  })
</script>
