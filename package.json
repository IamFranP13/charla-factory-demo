{
  "name": "charla-factory-demo",
  "version": "0.1.0",
  "private": true,
  "description": "A tiny AI factory: the audience asks, cheap agents build, a risk gate written in code decides.",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "node scripts/validate-content.mjs && node scripts/build-features.mjs && astro build && node scripts/deploy-meta.mjs",
    "dev": "node scripts/build-features.mjs && astro dev",
    "gate": "node scripts/gate.mjs",
    "preflight": "node scripts/preflight.mjs",
    "numbers": "node scripts/numbers.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "test:src": "node --test \"src/domain/*.test.mjs\" \"src/features/*/index.test.mjs\"",
    "reset-demo": "node scripts/reset-demo.mjs",
    "carga": "node scripts/carga.mjs",
    "rebuild": "node scripts/rebuild.mjs",
    "fabrica": "node scripts/fabrica.mjs",
    "agente:imagen": "docker build -f factory/agente/Dockerfile -t limonia-agente:dev .",
    "agente:medir": "node scripts/agente-medir.mjs",
    "proxy": "node scripts/proxy-red.mjs up",
    "proxy:red": "node scripts/proxy-red.mjs",
    "tarea": "node scripts/tarea.mjs",
    "comprobar": "node scripts/comprobar.mjs",
    "demo": "node scripts/demo.mjs"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "astro": "^7.4.2"
  }
}
